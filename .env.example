# ---------------------------------------------------------------------------
# Required — the process throws on startup if any of these are missing.
# ---------------------------------------------------------------------------

# Mongo connection string. In Coolify use the internal service hostname.
MONGODB_URI=mongodb://polyglot:polyglot@mongodb:27017

# Azure OpenAI (not openai.com) — key and resource endpoint.
OPENAI_SECRET_KEY=
OPENAI_ENDPOINT=

# Google OAuth *web* client id, used as the expected `aud` of incoming ID
# tokens. Must be the same id the editor signs in with, or every request 401s.
# Accepts a comma-separated list if a second client needs to be accepted.
# Not required when TEST_MODE=true.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

PORT=5000

# Prometheus scrape port, separate from PORT on purpose: the public hostname
# routes every path, so /metrics must not sit on the application port.
METRICS_PORT=9091

# Public host of this backend, WITHOUT a scheme — the code prepends https://
# (or http:// for localhost). Setting this also flips ENV to "production".
# It is embedded in the `#!polyglot-setup --serverurl ...` string handed to
# runtime notebooks, so a wrong value produces notebooks pointing nowhere.
DOMAIN_APP_DEPLOY=localhost:5000

# true  -> auth is bypassed entirely: every request resolves to the shared
#          "guest" user, and demo flows are seeded into the database on boot.
# false -> Google ID tokens are verified.
TEST_MODE=false

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Comma-separated. Note the CORS middleware currently reflects every origin;
# this list is only consulted for redirect validation in utils/auth.ts.
CORS_ORIGINS=*

# Gates the destructive `serverClean` maintenance routes, sent as the
# `x-maintenance-secret` header on a DELETE. Leave BLANK to disable those routes
# entirely (they then return 404). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MAINTENANCE_SECRET=

# Credentials for the external AI-generation service (read directly in
# src/api/api.ts). Missing values are interpolated as the string "undefined"
# and fail opaquely rather than loudly.
APIKEY=
SECRETKEY=

# PEM contents for a Mongo client certificate. Leave blank unless you need it —
# when set, MONGO_URL is currently assembled into a malformed connection string.
MONGODB_CERTIFICATE=
